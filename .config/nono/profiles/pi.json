{
  "meta": {
    "name": "pi",
    "version": "1.0.0"
  },
  "filesystem": {
    "unix_socket_dir": [
      "~/.config/herdr/"
    ],
    "write": [
      "./",
      "~/.cache/uv/",
      "~/.config/herdr",
      "~/.local/share/nvim/",
      "~/.local/state/nvim/",
      "~/.pi",
    ],
    "read": [
      "./",
      "/opt/homebrew/bin/",
      "~/.cache/uv",
      "~/.codegraph",
      "~/.config/herdr",
      "~/.config/nono/profiles/pi.json",
      "~/.gitconfig",
      "~/.local/config/nvim/",
      "~/.local/share/nvim",
      "~/.local/share/uv",
      "~/.local/state/nvim/",
      "~/.pi",
      "~/Library/Metadata/CoreSpotlight/PasteboardHistory/",
      "~/dotfiles/.config/nono/profiles/pi.json",
      "~/dotfiles/.pi",
      "~/homebrew",
      "~/miniforge3",
    ]
  },
  "network": {
    "allow_port": [
      1234,
      5432,
      11434
    ],
    "allow_domain": [
      "openrouter.ai",
      "pi.dev",
      "af-cheap.openai.azure.com",
      "secops-ai-foundry.services.ai.azure.com"
    ]
  }
}